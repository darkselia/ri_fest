# Docker Compose reads .env automatically. Never commit real secrets.
# Single quotes preserve literal $ characters. Use different database passwords.
DJANGO_SECRET_KEY=''
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DB_NAME=ri_fest
DB_USER=ri_fest
DB_PASSWORD=''
POSTGRES_ADMIN_PASSWORD=''

# Mailpit in Docker. For real delivery, use your SMTP provider's settings.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=''
EMAIL_HOST_PASSWORD=''
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@ri-fest.invalid
