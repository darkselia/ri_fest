# Django
DJANGO_SECRET_KEY=''
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# PostgreSQL: адрес и порт внутри сети Docker; пароли должны различаться.
DB_NAME=ri_fest
DB_USER=ri_fest
DB_PASSWORD=''
POSTGRES_ADMIN_PASSWORD=''
DB_HOST=db
DB_PORT=5432
# Отдельная база для PostgreSQL-тестов; имя обязательно заканчивается на _test.
DB_TEST_NAME=ri_fest_test

# Redis и каталог файлов внутри контейнера web.
CELERY_BROKER_URL=redis://redis:6379/0
CONTENT_MEDIA_ROOT=/var/lib/ri-fest/content

# Mailpit в Docker; для реальной почты укажите настройки SMTP-провайдера.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=''
EMAIL_HOST_PASSWORD=''
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@ri-fest.invalid

# Внешние порты только для compose.dev.yaml; внутренние порты не меняются.
DEV_WEB_PORT=8081
DEV_DB_PORT=5432
DEV_REDIS_PORT=6379
DEV_MAILPIT_WEB_PORT=8025
DEV_MAILPIT_SMTP_PORT=1025
