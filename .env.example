# Generate a local key; never copy a production key into this example.
DJANGO_SECRET_KEY=

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Dedicated local PostgreSQL database and role; use the password as-is.
DB_NAME=ri_fest
DB_USER=ri_fest
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
